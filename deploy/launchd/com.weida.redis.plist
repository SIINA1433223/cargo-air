<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  威达内网演示 · Redis（6379）
  注意：不要加 --daemonize，前台运行才由 launchd 管得住。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.weida.redis</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/redis/bin/redis-server</string>
        <string>--port</string>
        <string>6379</string>
        <string>--dir</string>
        <string>__HOME__/.local/redis/data</string>
        <string>--save</string>
        <string>60</string>
        <string>1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/weida-redis.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/weida-redis.log</string>
</dict>
</plist>
